#include <windows.h>
#ifndef EOD_WINDOWS_SETUP
@game_manifest_resource@
#endif
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
#if @PROJECT_VERSION_MAJOR@ == 1 && @PROJECT_VERSION_MINOR@ == 1 && @PROJECT_VERSION_PATCH@ == 1
FILEFLAGS VS_FF_PRERELEASE
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "ProductName", "Eve of Destruction Remaster\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
#ifdef EOD_WINDOWS_SETUP
   VALUE "FileDescription", "Eve of Destruction Remaster Settings and Save Import\0"
   VALUE "OriginalFilename", "eodsetup.exe\0"
#else
   VALUE "FileDescription", "Eve of Destruction Remaster Game\0"
   VALUE "OriginalFilename", "eod.exe\0"
#endif
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409,1200
 END
END
