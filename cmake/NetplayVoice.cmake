# Include after eod exists; caller owns this include and call order.
# Local builds use an installed Opus. Release builds can link a pinned static
# codec for the target architecture so players do not need a separate install.
include_guard(GLOBAL)
option(EOD_ENABLE_VOICE "Build the accountless voice codec when Opus is available" ON)
option(EOD_BUNDLED_OPUS "Build and link the release Opus codec from source" OFF)
function(eod_add_bundled_opus)
  include(FetchContent)
  set(BUILD_TESTING OFF)
  set(BUILD_SHARED_LIBS OFF)
  set(OPUS_BUILD_SHARED_LIBRARY OFF CACHE BOOL "" FORCE)
  set(OPUS_BUILD_TESTING OFF CACHE BOOL "" FORCE)
  set(OPUS_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(eod_opus
    URL https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
    URL_HASH SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1)
  FetchContent_MakeAvailable(eod_opus)
endfunction()
if(EOD_ENABLE_VOICE AND EOD_BUNDLED_OPUS)
  eod_add_bundled_opus()
endif()
function(eod_configure_voice target_name)
  if(NOT EOD_ENABLE_VOICE)
    message(STATUS "${target_name}: voice codec disabled")
    return()
  endif()
  if(EOD_BUNDLED_OPUS)
    set(voice_opus_target opus)
  else()
    find_package(Opus CONFIG QUIET)
    if(TARGET Opus::opus)
      set(voice_opus_target Opus::opus)
    elseif(TARGET opus)
      set(voice_opus_target opus)
    else()
      find_package(PkgConfig QUIET)
      if(PkgConfig_FOUND)
        pkg_check_modules(EOD_OPUS QUIET IMPORTED_TARGET opus>=1.3)
      endif()
      if(TARGET PkgConfig::EOD_OPUS)
        set(voice_opus_target PkgConfig::EOD_OPUS)
      endif()
    endif()
  endif()
  if(voice_opus_target)
    target_compile_definitions(${target_name} PRIVATE EOD_HAVE_OPUS)
    target_link_libraries(${target_name} PRIVATE ${voice_opus_target})
    message(STATUS "${target_name}: Opus voice codec enabled")
  else()
    message(STATUS "${target_name}: Opus unavailable; voice API explicitly reports unavailable")
  endif()
endfunction()
