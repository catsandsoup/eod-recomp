# Include after eod exists; caller owns this include and call order.
# Reuses an installed Opus implementation, never downloads or installs packages.
include_guard(GLOBAL)
option(EOD_ENABLE_VOICE "Build the accountless voice codec when Opus is available" ON)
function(eod_configure_voice target_name)
  if(NOT EOD_ENABLE_VOICE)
    message(STATUS "${target_name}: voice codec disabled")
    return()
  endif()
  find_package(Opus CONFIG QUIET)
  if(TARGET Opus::opus)
    set(voice_opus_target Opus::opus)
  elseif(TARGET opus)
    set(voice_opus_target opus)
  else()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_check_modules(EOD_OPUS QUIET IMPORTED_TARGET opus>=1.3)
    endif()
    if(TARGET PkgConfig::EOD_OPUS)
      set(voice_opus_target PkgConfig::EOD_OPUS)
    endif()
  endif()
  if(voice_opus_target)
    target_compile_definitions(${target_name} PRIVATE EOD_HAVE_OPUS)
    target_link_libraries(${target_name} PRIVATE ${voice_opus_target})
    message(STATUS "${target_name}: Opus voice codec enabled")
  else()
    message(STATUS "${target_name}: Opus unavailable; voice API explicitly reports unavailable")
  endif()
endfunction()
